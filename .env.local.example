COMPOSE_PROJECT_NAME=n3uron-librechat-v085

HOST=0.0.0.0
PORT=3085

DOMAIN_CLIENT=http://localhost:3085
DOMAIN_SERVER=http://localhost:3085
APP_TITLE=N3uron LibreChat Local
APP_DESCRIPTION=Local LibreChat workspace for N3uron operations using Docker-only local LLMs and N3uron MCP.
APP_URL=http://localhost:3085

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

JWT_SECRET=<generate-64-hex>
JWT_REFRESH_SECRET=<generate-64-hex>
CREDS_KEY=<generate-64-hex>
CREDS_IV=<generate-32-hex>

DEBUG_LOGGING=true
DEBUG_CONSOLE=true
AGENT_DEBUG_LOGGING=true

N3LOCAL_TOKEN=<set-local-n3uron-mcp-token>
